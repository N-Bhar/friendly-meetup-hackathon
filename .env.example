# Copy to .env, then pick your models.
# Defaults use local models via Ollama (see compose.yaml). For hosted providers, see docs/providers.md

# The agent being tested
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_API_KEY=
AGENT_MODEL=llama3.2:3b

# The judge that grades answers (tip: use a different, stronger model)
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=
JUDGE_MODEL=qwen2.5:7b

# Initial routing / harmful-input classification
CLASSIFIER_BASE_URL=http://localhost:11434/v1
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=llama3.2:3b

# Optional semantic index: pull an Ollama embedding model and set its name.
# Without this, the index uses lexical + reviewed-alias search only.
# For the semantic demo, install an embedding model (e.g. ollama pull embeddinggemma)
# and set EMBEDDING_MODEL=embeddinggemma. See docs/semantic-demo.md.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
